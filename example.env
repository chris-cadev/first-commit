# Copy to .env and adjust. Values here are safe defaults/examples.

# Comma-separated allowlist of Bitbucket Server (Data Center) hosts.
# Empty (or unset) means NO Bitbucket Server host is allowed.
BITBUCKET_SERVER_HOSTS=open-bitbucket.nrao.edu

# Optional: sqlite cache path, audit retention, cookie hardening.
# CACHE_DB_PATH=first_commit_cache.db
# AUDIT_RETENTION_DAYS=90
# AUDIT_LOG_IP=1
# CSRF_COOKIE_SECURE=0
